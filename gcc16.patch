     {
diff --git a/src/game/bouncers.cpp b/src/game/bouncers.cpp
index 3a5c2683..489ce5bc 100644
--- a/src/game/bouncers.cpp
+++ b/src/game/bouncers.cpp
@@ -362,7 +362,7 @@ namespace bouncers
                     }
                     else bnc.roll += rot;
                 }
-                else bnc.pitch = lerp(bnc.pitch, 180, 0.5f);
+                else bnc.pitch = lerpf(bnc.pitch, 180, 0.5f);
             }
 
             if(bouncerType == BNC_MOLOTOV)
diff --git a/src/game/weapon.cpp b/src/game/weapon.cpp
index 092cb504..3c24d7cd 100644
--- a/src/game/weapon.cpp
+++ b/src/game/weapon.cpp
@@ -205,7 +205,7 @@ namespace game
     float spread(int atk, gameent *d)
     {
         float aimProgress = getAimProgress(d);
-        return lerp((float)attacks[atk].noaimspread, (float)attacks[atk].aimspread, aimProgress);
+        return lerpf((float)attacks[atk].noaimspread, (float)attacks[atk].aimspread, aimProgress);
     }
 
     void createrays(int atk, const vec &from, const vec &to, gameent *d)             // create random spread of rays
@@ -433,7 +433,7 @@ namespace game
     {
         float distance = camera1->o.dist(v);
         if(distance > maxdist) return;
-        float factor = lerp(1.0f, 0.0f, distance / maxdist); // As normalized distance increases, the factor linearly decreases from 1 to 0
+        float factor = lerpf(1.0f, 0.0f, distance / maxdist); // As normalized distance increases, the factor linearly decreases from 1 to 0
         factor *= factorMod;
         shakeScreen(factor);
     }
diff --git a/src/shared/tools.cpp b/src/shared/tools.cpp
index 8cb72253..082412da 100644
--- a/src/shared/tools.cpp
+++ b/src/shared/tools.cpp
@@ -283,7 +283,7 @@ int rygbGradient(int val)
 int rgbToHex(int r, int g, int b) { return (r << 16) | (g << 8) | b; }
 void hexToRgb(int val, int &r, int &g, int &b) { r = (val >> 16) & 0xFF; g = (val >> 8) & 0xFF; b = val & 0xFF; }
 
-float lerp(float a, float b, float t) { return a + (b - a) * t; }
+float lerpf(float a, float b, float t) { return a + (b - a) * t; }
 
 float rndf(float min, float max) { return min + static_cast<float>(rand()) / (static_cast<float>(RAND_MAX / (max - min))); }
 
diff --git a/src/shared/tools.h b/src/shared/tools.h
